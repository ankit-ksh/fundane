#!/bin/bash

# Function to print usage
usage() {
    echo "Usage: $0 --command <command> --file <file_path>"
    echo "       $0 -c <command> -f <file_path>"
    exit 1
}

# Parse arguments
while [[ $# -gt 0 ]]; do
    case "$1" in
        -c|--command)
            COMMAND="$2"
            shift 2
            ;;
        -f|--file)
            FILE="$2"
            shift 2
            ;;
        *)
            echo "Unknown argument: $1"
            usage
            ;;
    esac
done

# Check if both arguments are provided
if [[ -z "$COMMAND" || -z "$FILE" ]]; then
    echo "Error: Both --command and --file must be specified."
    usage
fi

# Check if file exists
if [[ ! -f "$FILE" ]]; then
    echo "Error: File '$FILE' not found."
    exit 1
fi

# Execute the command with the file
echo "Running: $COMMAND \"$FILE\""
$COMMAND "$FILE"

